{
  "name": "pines-screenplay-studio",
  "productName": "Pines",
  "version": "1.0.0",
  "description": "Pines – Screenplay Studio (offline desktop app for Windows)",
  "main": "main.js",
  "author": "Pines Studio",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js && node scripts/vendor.js",
    "start": "npm run prepare-app && electron .",
    "dist:x64": "npm run prepare-app && electron-builder --win nsis --x64",
    "dist:ia32": "npm run prepare-app && electron-builder --win nsis --ia32",
    "dist": "npm run prepare-app && electron-builder --win nsis --x64 && electron-builder --win nsis --ia32"
  },
  "devDependencies": {
    "electron": "~43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "in.kalireads.pines",
    "productName": "Pines",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json", "build/icon.png", "app/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis" }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Pines-Setup-${version}-${arch}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pines",
      "deleteAppDataOnUninstall": false
    }
  }
}
